---
import { faviconUrl, getBoard, shortDate, tintChannels, usd, withUtm } from '../lib/sponsors.js';

// The rails don't render below 1560px; these sit between list rows instead.
// `index` cycles every live sponsor once, then every open slot once (cheapest
// first) — below 1560px these banners are the only place a buyer can see that
// slots are for sale, so the rotation must include them.
const { index = 0 } = Astro.props;
const board = await getBoard();
const rotation = [
  ...board.live.map((s) => ({ live: s })),
  ...[...board.open].sort((a, b) => a.priceCents - b.priceCents).map((s) => ({ open: s })),
];
const pick = rotation.length ? rotation[index % rotation.length] : {};
const slot = pick.live ?? null;
const openSlot = pick.open ?? null;
const sponsor = slot?.sponsor;
const icon = sponsor ? sponsor.logoUrl || faviconUrl(sponsor.url) : '';
---

{
  sponsor ? (
    <a
      class="sp-banner live"
      href={withUtm(sponsor.url)}
      target="_blank"
      rel="sponsored noopener"
      style={`--tint: ${tintChannels(sponsor.tint)}; --i: ${index}`}
      data-slot={slot.id}
      data-state="live"
    >
      <span class="sp-icon">
        {icon && <img src={icon} alt="" width="28" height="28" loading="lazy" />}
      </span>
      <span class="sp-text">
        <span class="sp-name">{sponsor.name}</span>
        <span class="sp-tag">{sponsor.tagline}</span>
      </span>
      <span class="sp-arrow">→</span>
    </a>
  ) : openSlot ? (
    <form class="sp-checkout-form" method="post" action="/api/sponsor/checkout" data-checkout data-astro-reload>
      <input type="hidden" name="slot" value={openSlot.id} />
      <button
        class="sp-banner open"
        type="submit"
        data-slot={openSlot.id}
        data-state="open"
        data-price={openSlot.priceCents}
      >
        <span class="sp-text">
          <span class="sp-name">your product here · {usd(openSlot.priceCents)}/30 days</span>
          <span class="sp-tag">read by builders choosing their AI-era stack</span>
        </span>
        <span class="sp-arrow">→</span>
      </button>
    </form>
  ) : board.reserved.length > 0 ? (
    <a class="sp-banner reserved" href="/sponsor" data-state="reserved">
      <span class="sp-text">
        <span class="sp-name">sponsor slots reserved</span>
        <span class="sp-tag">someone's grabbing them; check back soon</span>
      </span>
      <span class="sp-arrow">→</span>
    </a>
  ) : (
    <a class="sp-banner soldout" href="/sponsor#notify" data-state="soldout">
      <span class="sp-text">
        <span class="sp-name">{board.slots.length}/{board.slots.length} sponsor slots taken</span>
        <span class="sp-tag">
          {board.nextOpen
            ? `next opens ${shortDate(board.nextOpen.at)} at ${usd(board.nextOpen.priceCents)} · get notified`
            : 'get told when one opens'}
        </span>
      </span>
      <span class="sp-arrow">→</span>
    </a>
  )
}
