---
import Base from '../../layouts/Base.astro';
import { purchaseByToken } from '../../lib/db.js';
import { DEFAULT_TINT, LIMITS, RUN_DAYS, shortDate, tintChannels, usd } from '../../lib/sponsors.js';
import { getSession } from '../../lib/stripe.js';
import { promoteFromSession } from '../api/sponsor/webhook.js';

const token = Astro.url.searchParams.get('t') || '';
const sessionId = Astro.url.searchParams.get('session_id') || '';
let purchase = token ? await purchaseByToken(token) : null;

/* The webhook and this redirect race each other, and locally there is no webhook
   at all. Asking Stripe directly settles it: same conditional update, so whoever
   gets here second changes nothing. */
if (purchase && (purchase.status === 'hold' || purchase.status === 'expired_hold') && sessionId) {
  try {
    const promoted = await promoteFromSession(await getSession(sessionId));
    if (promoted && promoted.id === purchase.id) purchase = promoted;
  } catch (err) {
    console.error(`sponsor details session lookup failed: ${err?.message || err}`);
  }
}

const status = purchase?.status ?? 'missing';
const editable = status === 'paid' || status === 'submitted';
const tint = purchase?.tint || DEFAULT_TINT;

const title = 'Your sponsor slot · canivibecodeit';
const description = 'Finish setting up your sponsor placement.';
---

<Base {title} {description}>
  <main class="wrap sponsor-page">
    {
      !purchase && (
        <section class="sp-hero">
          <h1>That link's no good.</h1>
          <p class="sub">
            Check the link in your receipt email, or reply to it and a human will sort it out.
          </p>
        </section>
      )
    }

    {
      purchase && status === 'hold' && (
        <section class="sp-hero">
          <h1>Still waiting on the payment.</h1>
          <p class="sub">
            Stripe hasn't confirmed this one yet. Give it a minute and reload. If it never
            confirms, nothing was charged and the slot goes back on sale.
          </p>
        </section>
      )
    }

    {
      purchase && status === 'live' && (
        <section class="sp-hero">
          <h1>You're live.</h1>
          <p class="sub">
            <b>{purchase.name}</b> is running in slot {purchase.slot_id} until{' '}
            {shortDate(purchase.ends_at)}. Reply to your approval email if anything needs changing.
          </p>
        </section>
      )
    }

    {
      purchase && !editable && status !== 'hold' && status !== 'live' && (
        <section class="sp-hero">
          <h1>Nothing to do here.</h1>
          <p class="sub">
            This slot isn't editable any more. Email
            <a href="mailto:hello@canivibecodeit.com"> hello@canivibecodeit.com</a> if that's a surprise.
          </p>
        </section>
      )
    }

    {
      editable && (
        <>
          <section class="sp-hero">
            <h1>{status === 'submitted' ? 'Got it. Waiting on approval.' : "Paid. Now, who are you?"}</h1>
            <p class="sub">
              Slot {purchase.slot_id} · {usd(purchase.amount_cents)} · {RUN_DAYS * (Number(purchase.months) || 1)} days from the moment
              it's approved.{' '}
              {status === 'submitted'
                ? "We've got it. You can still change anything below until it goes live."
                : 'Three fields, then we review it, usually within a few hours.'}
            </p>
          </section>

          <section class="sp-form-wrap">
            <form
              class="sp-form"
              method="post"
              action="/api/sponsor/details"
              data-sponsor-details
            >
              <input type="hidden" name="t" value={token} />

              <label>
                <span class="microlabel">product name</span>
                <input
                  type="text"
                  name="name"
                  autocomplete="off"
                  id="sp-name"
                  maxlength={LIMITS.name}
                  required
                  placeholder="Acme"
                  value={purchase.name ?? ''}
                />
              </label>

              <label>
                <span class="microlabel">
                  one line <b class="sp-count" id="sp-tag-count" />
                </span>
                <input
                  type="text"
                  name="tagline"
                  autocomplete="off"
                  id="sp-tagline"
                  maxlength={LIMITS.tagline}
                  required
                  placeholder="the thing you do, in six words"
                  value={purchase.tagline ?? ''}
                />
              </label>

              <label>
                <span class="microlabel">where it links</span>
                {/* text, not url: type="url" refuses to submit "acme.com" at all,
                    and the scheme gets filled in on blur anyway. */}
                <input
                  type="text"
                  inputmode="url"
                  name="url"
                  autocomplete="off"
                  id="sp-url"
                  required
                  placeholder="acme.com"
                  value={purchase.url ?? ''}
                />
              </label>

              <label>
                <span class="microlabel">icon url · optional, we grab your favicon otherwise</span>
                <input
                  type="text"
                  inputmode="url"
                  name="logo_url"
                  autocomplete="off"
                  id="sp-logo"
                  placeholder="acme.com/icon.png"
                  value={purchase.logo_url ?? ''}
                />
              </label>

              <label class="sp-color">
                <span class="microlabel">card color</span>
                <span class="sp-color-row">
                  <input type="color" name="tint" id="sp-tint" value={tint} />
                  <span class="sp-color-hint">defaults to your icon's color; change it if you'd rather stand out</span>
                </span>
              </label>

              <div class="sp-preview-wrap">
                <span class="microlabel">this is the card</span>
                <div class="sp-preview">
                  <span
                    class="sp-card live"
                    id="sp-preview-card"
                    style={`--tint: ${tintChannels(tint)}; --i: 0`}
                  >
                    <span class="sp-icon"><img id="sp-preview-icon" src="" alt="" width="26" height="26" /></span>
                    <span class="sp-name" id="sp-preview-name">{purchase.name ?? 'your product'}</span>
                    <span class="sp-tag" id="sp-preview-tag">{purchase.tagline ?? 'your one line here'}</span>
                  </span>
                </div>
              </div>

              <p class="sp-form-msg" id="sp-msg" role="status"></p>
              <button class="btn primary" type="submit">
                {status === 'submitted' ? 'update it' : 'send it for approval'}
              </button>
              <p class="fine">
                We approve every placement by hand. If it isn't a fit you get a full refund, no argument.
              </p>
            </form>
          </section>
        </>
      )
    }
  </main>
</Base>

<script is:inline define:vars={{ defaultTint: DEFAULT_TINT, maxTag: LIMITS.tagline }}>
  (() => {
    const form = document.querySelector('[data-sponsor-details]');
    if (!form) return;
    const $ = (id) => document.getElementById(id);
    const card = $('sp-preview-card');
    const iconEl = $('sp-preview-icon');
    const tintEl = $('sp-tint');

    const channels = (hex) =>
      [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ');

    const setTint = (hex) => {
      tintEl.value = hex;
      card.style.setProperty('--tint', channels(hex));
    };

    /* Once the sponsor picks a colour it is theirs: editing the URL afterwards
       must not silently overwrite it with whatever the new icon samples to. */
    let userPicked = false;
    tintEl.addEventListener('input', () => {
      userPicked = true;
      card.style.setProperty('--tint', channels(tintEl.value));
    });

    /* The icon suggests the starting colour. Cross-origin images usually taint
       the canvas, and that's fine — the site green is a perfectly good default,
       and the sponsor can pick anything they like from here. */
    const sampleTint = (img) => {
      try {
        const c = document.createElement('canvas');
        c.width = c.height = 16;
        const ctx = c.getContext('2d', { willReadFrequently: true });
        ctx.drawImage(img, 0, 0, 16, 16);
        const { data } = ctx.getImageData(0, 0, 16, 16);
        let r = 0, g = 0, b = 0, n = 0;
        for (let i = 0; i < data.length; i += 4) {
          const alpha = data[i + 3];
          if (alpha < 128) continue;
          const max = Math.max(data[i], data[i + 1], data[i + 2]);
          const min = Math.min(data[i], data[i + 1], data[i + 2]);
          // Skip near-greys: they average out to mud and lose the brand colour.
          if (max - min < 24) continue;
          r += data[i];
          g += data[i + 1];
          b += data[i + 2];
          n++;
        }
        if (!n) return defaultTint;
        const hex = (v) => Math.round(v / n).toString(16).padStart(2, '0');
        return `#${hex(r)}${hex(g)}${hex(b)}`;
      } catch {
        return defaultTint;
      }
    };

    // Mirrors cleanUrl on the server: a bare "superx.so" is a URL.
    const withScheme = (v) => {
      const s = String(v || '').trim();
      return !s || /^[a-z][a-z0-9+.-]*:/i.test(s) ? s : `https://${s}`;
    };

    // What you see is what gets submitted.
    const normalize = (el) => {
      const next = withScheme(el.value);
      if (next !== el.value) el.value = next;
    };

    const loadIcon = () => {
      const explicit = withScheme($('sp-logo').value);
      let src = explicit;
      if (!src) {
        try {
          src = `https://www.google.com/s2/favicons?domain=${new URL(withScheme($('sp-url').value)).hostname}&sz=64`;
        } catch {
          src = '';
        }
      }
      if (!src) return;
      const probe = new Image();
      probe.crossOrigin = 'anonymous';
      probe.onload = () => {
        iconEl.src = src;
        if (!userPicked) setTint(sampleTint(probe));
      };
      probe.onerror = () => {
        iconEl.src = src;
        if (!userPicked) setTint(defaultTint);
      };
      probe.src = src;
    };

    const syncText = () => {
      $('sp-preview-name').textContent = $('sp-name').value.trim() || 'your product';
      $('sp-preview-tag').textContent = $('sp-tagline').value.trim() || 'your one line here';
      $('sp-tag-count').textContent = `${$('sp-tagline').value.length}/${maxTag}`;
    };

    $('sp-name').addEventListener('input', syncText);
    $('sp-tagline').addEventListener('input', syncText);
    for (const id of ['sp-url', 'sp-logo']) {
      const el = $(id);
      el.addEventListener('blur', () => {
        normalize(el);
        loadIcon();
      });
      el.addEventListener('change', loadIcon);
    }
    syncText();
    loadIcon();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]');
      const msg = $('sp-msg');
      btn.disabled = true;
      const res = await fetch('/api/sponsor/details', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      }).catch(() => null);
      const data = await res?.json().catch(() => ({}));
      if (res?.ok) {
        msg.textContent = "sent. we review every sponsor by hand; you'll get an email either way.";
        msg.className = 'sp-form-msg ok';
        btn.textContent = 'update it';
      } else {
        msg.textContent = data?.error || 'something broke · try again';
        msg.className = 'sp-form-msg bad';
      }
      btn.disabled = false;
    });
  })();
</script>
