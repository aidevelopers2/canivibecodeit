---
// Your account: stack list, digest toggle, sign out, delete. Server-rendered
// from the session; signed-out visitors go to /signin.
import Base from '../layouts/Base.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { getApp } from '../lib/apps.js';
import { stackSlugs } from '../lib/db.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/signin');

const slugs = await stackSlugs(user.id);
const apps = slugs.map((s) => getApp(s)).filter(Boolean);
const monthly = Math.round(apps.reduce((sum, a) => sum + (a.priceMonthly ?? 0), 0));
const digestOn = user.newsletter === true;
---

<Base title="Your account · canivibecodeit" description="Your stack, your digest, nothing else.">
  <main class="wrap account-wrap">
    <header class="account-head">
      <h1>Your account</h1>
      <p class="microlabel">{user.email}</p>
    </header>

    <section class="account-section">
      <div class="section-head">
        <span class="microlabel">my stack · {apps.length} {apps.length === 1 ? 'app' : 'apps'}</span>
        {monthly > 0 && <span class="microlabel saved-line">${monthly}/mo you could stop paying</span>}
      </div>
      {
        apps.length === 0 ? (
          <p class="empty">
            nothing saved yet. find an app on <a href="/#death-list">the death list</a> and hit
            "+ save to my stack".
          </p>
        ) : (
          <div class="stack-rows">
            {apps.map((app) => (
              <div class="stack-row">
                <img src={`/icons/${app.slug}.png`} alt="" width="24" height="24" loading="lazy" />
                <a class="stack-name" href={`/${app.slug}`}>{app.name}</a>
                <span class="stack-price">{app.priceMonthly != null ? `$${app.priceMonthly}/mo` : 'varies'}</span>
                <span class="stack-verdict"><VerdictBadge verdict={app.verdict} /></span>
                <button class="stack-remove" data-stack-remove={app.slug}>remove</button>
              </div>
            ))}
          </div>
        )
      }
    </section>

    <section class="account-section">
      <span class="microlabel">weekly digest</span>
      <div class="digest-card">
        <div class="digest-text">
          <span class="digest-state" data-digest-state>{digestOn ? 'subscribed' : 'not subscribed'}</span>
          <span class="digest-desc">verdicts that changed, case studies, tips. one email a week, one click to leave.</span>
        </div>
        <button
          class:list={['toggle', { on: digestOn }]}
          data-digest-toggle
          data-on={digestOn ? '1' : null}
          role="switch"
          aria-checked={digestOn ? 'true' : 'false'}
          aria-label="weekly digest subscription"
        ><span class="knob"></span></button>
      </div>
    </section>

    <section class="account-section">
      <span class="microlabel">account</span>
      <div class="account-actions">
        <button class="btn ghost" data-signout>sign out</button>
        <button class="btn danger" data-delete-account>delete account</button>
      </div>
      <p class="danger-note">delete wipes your stack and takes your email off the digest. no soft-delete, no exit survey.</p>
    </section>
  </main>
</Base>

<style>
  .account-wrap {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .account-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .account-head h1 {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 36px);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .account-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .saved-line {
    color: var(--primary);
  }
  .empty {
    color: var(--muted);
    font-size: 14px;
  }
  .stack-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .stack-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .stack-row img {
    border-radius: 5px;
    flex-shrink: 0;
  }
  .stack-name {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
    text-decoration: none;
    color: var(--fg);
  }
  .stack-name:hover {
    color: var(--primary);
  }
  .stack-price {
    width: 90px;
    flex-shrink: 0;
    color: var(--muted);
    font-size: 13px;
  }
  .stack-verdict {
    width: 110px;
    flex-shrink: 0;
  }
  .stack-remove {
    background: none;
    border: none;
    padding: 4px;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .stack-remove:hover {
    color: var(--no, #ff4444);
  }
  .digest-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .digest-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .digest-state {
    font-weight: 500;
    font-size: 14px;
  }
  .digest-desc {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .toggle {
    width: 40px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 11px;
    border: none;
    background: var(--surface-2);
    padding: 2px;
    display: flex;
    justify-content: flex-start;
    cursor: pointer;
    transition: background 0.15s var(--ease-out, ease);
  }
  .toggle .knob {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: var(--muted);
    transition: transform 0.15s var(--ease-out, ease), background 0.15s var(--ease-out, ease);
  }
  .toggle.on {
    background: color-mix(in srgb, var(--primary) 25%, transparent);
  }
  .toggle.on .knob {
    transform: translateX(18px);
    background: var(--primary);
  }
  .account-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn.danger {
    border: 1px solid color-mix(in srgb, #ff4444 30%, transparent);
    color: #ff4444;
    background: transparent;
  }
  .btn.danger:hover {
    background: color-mix(in srgb, #ff4444 8%, transparent);
  }
  .danger-note {
    color: var(--muted);
    font-size: 12px;
    margin: 0;
  }
  @media (max-width: 600px) {
    .stack-price {
      display: none;
    }
    .stack-verdict {
      width: auto;
    }
    .account-actions {
      flex-direction: column;
    }
    .account-actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
